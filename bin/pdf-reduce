#!/usr/bin/env python3
"""Riduce i PDF selezionati in Nemo con Ghostscript, verso una dimensione massima o con impostazioni manuali."""

import os
import shutil
import sys
import tempfile

sys.dont_write_bytecode = True
from nemo_common import (Cancelled, Worker, check_pdfs, human_size, publish,  # noqa: E402
                         relative_names, selected_files)
import tkinter as tk  # noqa: E402
from tkinter import messagebox, ttk  # noqa: E402

TITLE = "PDF reduce"
# Livelli dal più fedele al più compresso: (dpi delle immagini, qualità JPEG).
LEVELS = [(300, 90), (300, 80), (250, 80), (200, 80), (200, 70), (170, 70), (150, 70), (150, 60),
          (130, 60), (110, 55), (96, 50), (85, 45), (72, 40), (60, 35), (50, 30), (36, 25)]


def qfactor(quality: int) -> float:
    """Converte una qualità JPEG 1-100 nel QFactor di Ghostscript (scala IJG: 50 → 1,0)."""
    quality = max(1, min(100, quality))
    return max(0.05, (200 - 2 * quality) / 100 if quality >= 50 else 50 / quality)


def gs_command(source: str, output: str, dpi: int, quality: int, gray: bool) -> list[str]:
    jpeg = f"<< /QFactor {qfactor(quality):.2f} /Blend 1 /HSamples [2 1 1 2] /VSamples [2 1 1 2] >>"
    command = [
        "gs", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.5", "-dNOPAUSE", "-dBATCH", "-dQUIET", "-dSAFER",
        "-dDetectDuplicateImages=true", "-dCompressFonts=true", "-dSubsetFonts=true",
        # Senza questi le immagini JPEG originali verrebbero copiate senza ricomprimerle.
        "-dPassThroughJPEGImages=false", "-dPassThroughJPXImages=false",
        "-dDownsampleColorImages=true", "-dColorImageDownsampleType=/Bicubic",
        "-dColorImageDownsampleThreshold=1.0", f"-dColorImageResolution={dpi}",
        "-dDownsampleGrayImages=true", "-dGrayImageDownsampleType=/Bicubic",
        "-dGrayImageDownsampleThreshold=1.0", f"-dGrayImageResolution={dpi}",
        # Le immagini in bianco e nero (testo scansionato) restano leggibili.
        "-dDownsampleMonoImages=true", "-dMonoImageDownsampleType=/Subsample",
        "-dMonoImageDownsampleThreshold=1.0", f"-dMonoImageResolution={max(dpi, 150)}",
        "-dAutoFilterColorImages=false", "-dColorImageFilter=/DCTEncode",
        "-dAutoFilterGrayImages=false", "-dGrayImageFilter=/DCTEncode",
    ]
    if gray:
        command += ["-sColorConversionStrategy=Gray", "-dProcessColorModel=/DeviceGray"]
    # In -sOutputFile Ghostscript interpreta "%" come formato del numero di pagina.
    command += [f"-sOutputFile={output.replace('%', '%%')}",
                "-c", f"<< /ColorImageDict {jpeg} /GrayImageDict {jpeg} >> setdistillerparams", "-f", source]
    return command


files = selected_files()
names = relative_names(files)

root = tk.Tk()
root.title(TITLE)
root.minsize(640, 480)
root.geometry("860x580")
root.columnconfigure(0, weight=1)
root.rowconfigure(0, weight=1)

error = check_pdfs(files) or (None if shutil.which("gs") else "Manca il programma richiesto: gs (ghostscript).")
if error:
    root.withdraw()
    messagebox.showerror(TITLE, error, parent=root)
    root.destroy()
    sys.exit(1)

main = ttk.Frame(root, padding=12)
main.grid(row=0, column=0, sticky="nsew")
main.columnconfigure(0, weight=1)
main.rowconfigure(0, weight=1)

list_frame = ttk.LabelFrame(main, text="PDF selezionati", padding=6)
list_frame.grid(row=0, column=0, sticky="nsew")
list_frame.columnconfigure(0, weight=1)
list_frame.rowconfigure(0, weight=1)
tree = ttk.Treeview(list_frame, columns=("name", "size", "result"), show="headings", selectmode="none", height=6)
tree.heading("name", text="Percorso relativo")
tree.heading("size", text="Originale")
tree.heading("result", text="Risultato")
tree.column("name", width=380, anchor="w")
tree.column("size", width=90, stretch=False, anchor="e")
tree.column("result", width=320, anchor="w")
scroll_y = ttk.Scrollbar(list_frame, orient="vertical", command=tree.yview)
tree.configure(yscrollcommand=scroll_y.set)
tree.grid(row=0, column=0, sticky="nsew")
scroll_y.grid(row=0, column=1, sticky="ns")
sizes = [os.path.getsize(path) for path in files]
for index, name in enumerate(names):
    tree.insert("", "end", iid=str(index), values=(name, human_size(sizes[index]), ""))

options = ttk.LabelFrame(main, text="Compressione", padding=8)
options.grid(row=1, column=0, sticky="ew", pady=(12, 0))
mode_var = tk.StringVar(value="target")
target_var = tk.StringVar(value="500")
dpi_var = tk.StringVar(value="150")
quality_var = tk.IntVar(value=70)
gray_var = tk.BooleanVar(value=False)
suffix_var = tk.StringVar(value="-ridotto")

target_radio = ttk.Radiobutton(options, text="Dimensione massima per ciascun PDF", variable=mode_var, value="target")
target_radio.grid(row=0, column=0, sticky="w")
target_entry = ttk.Spinbox(options, from_=10, to=1_000_000, increment=50, width=9, textvariable=target_var)
target_entry.grid(row=0, column=1, sticky="w", padx=(8, 4))
ttk.Label(options, text="KB").grid(row=0, column=2, sticky="w")

manual_radio = ttk.Radiobutton(options, text="Impostazioni manuali", variable=mode_var, value="manual")
manual_radio.grid(row=1, column=0, sticky="w", pady=(6, 0))
manual_frame = ttk.Frame(options)
manual_frame.grid(row=1, column=1, columnspan=4, sticky="w", pady=(6, 0), padx=(8, 0))
ttk.Label(manual_frame, text="Risoluzione immagini").pack(side="left")
dpi_entry = ttk.Spinbox(manual_frame, from_=36, to=1200, increment=10, width=6, textvariable=dpi_var)
dpi_entry.pack(side="left", padx=(6, 2))
ttk.Label(manual_frame, text="dpi").pack(side="left", padx=(0, 16))
ttk.Label(manual_frame, text="Qualità JPEG").pack(side="left")
quality_scale = ttk.Scale(manual_frame, from_=10, to=95, length=160,
                          command=lambda value: quality_var.set(round(float(value))))
quality_scale.set(quality_var.get())
quality_scale.pack(side="left", padx=6)
ttk.Label(manual_frame, textvariable=quality_var, width=3).pack(side="left")

gray_check = ttk.Checkbutton(options, text="Converti in scala di grigi", variable=gray_var)
gray_check.grid(row=2, column=0, columnspan=3, sticky="w", pady=(8, 0))

name_frame = ttk.Frame(options)
name_frame.grid(row=3, column=0, columnspan=5, sticky="w", pady=(8, 0))
ttk.Label(name_frame, text="Nome dei file ridotti:  nome").pack(side="left")
suffix_entry = ttk.Entry(name_frame, textvariable=suffix_var, width=14)
suffix_entry.pack(side="left", padx=2)
ttk.Label(name_frame, text=".pdf  (accanto a ciascun originale; nessun file viene sovrascritto)").pack(side="left")

status_var = tk.StringVar()
ttk.Label(main, textvariable=status_var, wraplength=820).grid(row=2, column=0, sticky="w", pady=(10, 0))
progress = ttk.Progressbar(main, maximum=len(files), mode="determinate")
progress.grid(row=3, column=0, sticky="ew", pady=(6, 0))

buttons = ttk.Frame(main)
buttons.grid(row=4, column=0, sticky="e", pady=(12, 0))
start_button = ttk.Button(buttons, text="Riduci")
start_button.pack(side="right", padx=(8, 0))
close_button = ttk.Button(buttons, text="Chiudi")
close_button.pack(side="right")

controls = [target_radio, target_entry, manual_radio, dpi_entry, quality_scale, gray_check, suffix_entry]
destinations = []
worker = None
finished = False


def destination_for(path: str, suffix: str) -> str:
    return os.path.join(os.path.dirname(path), os.path.splitext(os.path.basename(path))[0] + suffix + ".pdf")


def read_int(variable: tk.StringVar, low: int, high: int) -> int | None:
    text = variable.get().strip()
    if not text.isdigit():
        return None
    value = int(text)
    return value if low <= value <= high else None


def settings() -> tuple[dict | None, str]:
    """Restituisce le impostazioni valide oppure (None, motivo)."""
    suffix = suffix_var.get()
    if not suffix or "/" in suffix or "\n" in suffix:
        return None, "Il suffisso del nome non può essere vuoto né contenere '/'."
    targets = [destination_for(path, suffix) for path in files]
    if len(set(targets)) != len(targets):
        return None, "Due PDF selezionati produrrebbero lo stesso nome: cambia il suffisso."
    for target in targets:
        if os.path.lexists(target):
            return None, f"Esiste già e non verrà sovrascritto: {target}"
    result = {"suffix": suffix, "targets": targets, "gray": gray_var.get(), "mode": mode_var.get()}
    if result["mode"] == "target":
        kb = read_int(target_var, 10, 10_000_000)
        if kb is None:
            return None, "Inserisci una dimensione massima in KB (numero intero, almeno 10)."
        result["target"] = kb * 1024
        return result, f"Ogni PDF verrà ridotto sotto {kb} KB, con la qualità più alta possibile."
    dpi = read_int(dpi_var, 36, 1200)
    if dpi is None:
        return None, "Inserisci una risoluzione tra 36 e 1200 dpi."
    result["dpi"] = dpi
    result["quality"] = quality_var.get()
    return result, f"Immagini a {dpi} dpi al massimo, qualità JPEG {quality_var.get()}."


def update_state(*_args) -> None:
    if worker and worker.running() or finished:
        return
    manual = mode_var.get() == "manual"
    target_entry.configure(state="disabled" if manual else "normal")
    dpi_entry.configure(state="normal" if manual else "disabled")
    quality_scale.state(["!disabled"] if manual else ["disabled"])
    config, message = settings()
    status_var.set(message)
    start_button.configure(state="normal" if config else "disabled")


def compress(job: Worker, config: dict) -> None:
    for index, source in enumerate(files):
        job.post("row", index, "in corso…")
        original = sizes[index]
        workdir = tempfile.mkdtemp(prefix=".pdf-reduce.", dir=os.path.dirname(source))
        try:
            tried = {}

            def attempt(dpi: int, quality: int, step: int) -> int:
                job.post("progress", index, step, f"{names[index]}: {dpi} dpi, qualità {quality}")
                candidate = os.path.join(workdir, f"{dpi}-{quality}.pdf")
                job.run(gs_command(source, candidate, dpi, quality, config["gray"]))
                if not os.path.isfile(candidate) or os.path.getsize(candidate) == 0:
                    raise RuntimeError("Ghostscript non ha prodotto un PDF valido.")
                tried[candidate] = os.path.getsize(candidate)
                return tried[candidate]

            note = ""
            if config["mode"] == "manual":
                attempt(config["dpi"], config["quality"], 0)
                best = next(iter(tried))
            elif original <= config["target"]:
                job.post("row", index, "già sotto il limite: nessun file creato")
                continue
            else:
                # Ricerca binaria del primo livello che rientra nel limite
                # (le dimensioni scendono quasi sempre lungo LEVELS).
                low, high, found, step = 0, len(LEVELS) - 1, None, 0
                if attempt(*LEVELS[high], step) <= config["target"]:
                    found = high
                    high -= 1
                    while low <= high:
                        step += 1
                        middle = (low + high) // 2
                        if attempt(*LEVELS[middle], step) <= config["target"]:
                            found, high = middle, middle - 1
                        else:
                            low = middle + 1
                    best = os.path.join(workdir, "{}-{}.pdf".format(*LEVELS[found]))
                else:
                    best = min(tried, key=tried.get)
                    note = " — limite non raggiunto"
            size = tried[best]
            if size >= original:
                job.post("row", index, f"non riducibile ({human_size(size)} ≥ originale): nessun file creato")
                continue
            publish(best, config["targets"][index])
            saving = int(100 * (1 - size / original))
            job.post("row", index, f"{human_size(size)} (−{saving}%){note}")
        except RuntimeError as exc:
            job.post("row", index, "errore")
            job.post("error", index, str(exc))
        except FileExistsError as exc:
            job.post("row", index, f"esiste già: {os.path.basename(str(exc))}")
        finally:
            shutil.rmtree(workdir, ignore_errors=True)
            job.post("progress", index + 1, 0, "")


errors = []


def on_message(kind: str, index: int, *payload) -> None:
    if kind == "row":
        tree.set(str(index), "result", payload[0])
        tree.see(str(index))
    elif kind == "progress":
        step, text = payload
        # In modalità automatica servono al massimo circa 5 tentativi per file.
        progress["value"] = index + min(step, 4) / 5
        if text:
            status_var.set(f"File {index + 1} di {len(files)} — {text}")
    elif kind == "error":
        errors.append(f"{names[index]}:\n{payload[0]}")


def on_done(exc: BaseException | None) -> None:
    global finished
    finished = True
    root.configure(cursor="")
    close_button.configure(text="Chiudi")
    if isinstance(exc, Cancelled):
        for item in tree.get_children():
            if tree.set(item, "result") in ("", "in corso…"):
                tree.set(item, "result", "interrotto: nessun file creato")
        status_var.set("Interrotto. I PDF già completati sono stati salvati.")
    elif exc is not None:
        status_var.set("Errore inatteso.")
        messagebox.showerror(TITLE, str(exc), parent=root)
    else:
        progress["value"] = len(files)
        status_var.set("Completato." + (" Alcuni PDF non sono stati ridotti per errore." if errors else ""))
    if errors:
        messagebox.showerror(TITLE, "\n\n".join(errors)[-3000:], parent=root)


def start(*_args) -> None:
    global worker
    config, _message = settings()
    if config is None or (worker and worker.running()) or finished:
        return
    for control in controls:
        control.state(["disabled"])
    start_button.configure(state="disabled")
    close_button.configure(text="Interrompi")
    root.configure(cursor="watch")
    progress["value"] = 0
    worker = Worker(root, on_message, on_done)
    worker.start(compress, config)


def close(*_args) -> None:
    if worker and worker.running():
        worker.cancel()
        return
    root.destroy()


def on_window_close() -> None:
    if worker and worker.running():
        worker.cancel()
    root.destroy()


start_button.configure(command=start)
close_button.configure(command=close)
root.protocol("WM_DELETE_WINDOW", on_window_close)
root.bind("<Return>", start)
root.bind("<Escape>", close)
for variable in (mode_var, target_var, dpi_var, suffix_var):
    variable.trace_add("write", update_state)
quality_var.trace_add("write", update_state)
update_state()
target_entry.focus_set()
root.mainloop()
